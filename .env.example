# Causara Environment Configuration Template
# Copy to .env for local development. Never commit .env with real credentials.

# Flask Application Settings
FLASK_ENV=development
SECRET_KEY=dev-secret-key-replace-in-production-with-random-entropy
PORT=5000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# =============================================================================
# Database Configuration (Azure SQL Database / Microsoft SQL Server)
# =============================================================================
# Option A: Full Connection String (Recommended for Azure SQL / Production)
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=tcp:causara-sql.database.windows.net,1433;Database=causara-db;Uid=causara-admin;Pwd=YourSecurePassword!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Option B: Component Configuration (Recommended for Local Development with LocalDB)
# Prerequisites: The target database must be created on the SQL Server instance before connecting:
#   sqlcmd -S "(localdb)\CausaraDB" -Q "IF DB_ID('CausaraDB') IS NULL CREATE DATABASE CausaraDB;"
DB_SERVER=(localdb)\CausaraDB
DB_NAME=CausaraDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# For SQL Server Authentication (if not using Windows Integrated / Trusted Connection)
# DB_USER=causara_user
# DB_PASSWORD=your_secure_password

