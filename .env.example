# =============================================================================
# Causara Environment Configuration Template
# =============================================================================
# Copy this file to .env in the project root:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Configure the values according to your environment (LocalDB vs Azure SQL / Storage).
# Never commit your real .env file or credentials to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Flask Application Settings
# -----------------------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=dev-secret-key-replace-in-production-with-random-entropy
PORT=5000

# Internal operational API key for private maintenance and outbox endpoints
INTERNAL_API_KEY=dev-internal-key

# -----------------------------------------------------------------------------
# 2. CORS Configuration (comma-separated origins)
# -----------------------------------------------------------------------------
# Local development (Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Azure deployment (replace with your Azure Static Web Apps URL or custom domain):
# CORS_ORIGINS=https://<your-static-web-app-name>.azurestaticapps.net

# -----------------------------------------------------------------------------
# 3. Database Configuration (Azure SQL Database vs. SQL Server LocalDB)
# -----------------------------------------------------------------------------
# OPTION A: Azure SQL Database (Recommended for Azure deployments)
# Obtain from Azure Portal -> SQL Database -> Settings -> Connection strings -> ODBC.
# Replace {your_password_here} with your actual SQL admin password.
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:causara-sql.database.windows.net,1433;Database=causara-db;Uid=causara-admin;Pwd=YourSecurePassword!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# OPTION B: Microsoft SQL Server LocalDB (Default for local development)
DB_SERVER=(localdb)\CausaraDB
DB_NAME=CausaraDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# For SQL Server Authentication (if not using Windows Integrated / Trusted Connection):
# DB_USER=causara_user
# DB_PASSWORD=your_secure_password

# -----------------------------------------------------------------------------
# 4. Evidence Storage Configuration (Azure Blob Storage vs. Local Disk)
# -----------------------------------------------------------------------------
# Storage Provider Selection: 'local' (default for local dev) or 'azure' (for Azure deployments)
STORAGE_PROVIDER=local

# Azure Blob Storage Configuration (Required when STORAGE_PROVIDER=azure or in production):
# Obtain connection string from Azure Portal -> Storage account -> Security + networking -> Access keys.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=causarastorage;AccountKey=YourStorageAccountKey==;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=evidence

# -----------------------------------------------------------------------------
# 5. Frontend API Base URL (Reference for Frontend build)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
