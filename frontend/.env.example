# =============================================================================
# Causara Frontend Environment Configuration Template
# =============================================================================
# Copy this file to frontend/.env for local overrides if needed.
# Note: In Vite, VITE_* environment variables are statically embedded into
# JavaScript bundles during `npm run build`.
# =============================================================================

# OPTION 1: Local development with Vite proxy (Recommended for local dev)
# Vite dev server proxies requests from http://localhost:5173/api to http://localhost:5000/api
VITE_API_BASE_URL=/api/v1

# OPTION 2: Local development connecting directly to Flask backend cross-origin
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# OPTION 3: Azure deployment (Azure Static Web Apps connecting to Azure App Service)
# Pass this environment variable during GitHub Actions build or Azure SWA build settings:
# VITE_API_BASE_URL=https://<your-app-service-name>.azurewebsites.net/api/v1
